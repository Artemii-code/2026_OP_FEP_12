#include <stdio.h>
#include <math.h>
int main() {
double a, b, c; // Коефіцієнти рівняння
double discriminant, root1, root2, realPart, imagPart;
// Введення коефіцієнтів
printf("Введіть коефіцієнти a, b і c: ");
scanf("%lf %lf %lf", &a, &b, &c);
// Обчислення дискримінанта
discriminant = b * b - 4 * a * c;// Перевірка дискримінанта і обчислення коренів
if (discriminant > 0) {
// Два різних дійсних корені
root1 = (-b + sqrt(discriminant)) / (2 * a);
root2 = (-b - sqrt(discriminant)) / (2 * a);
printf("Рівняння має два дійсні корені: %.2lf і %.2lf\n", root1, root2);
}
else if (discriminant == 0) {
// Один дійсний корінь
root1 = -b / (2 * a);
printf("Рівняння має один дійсний корінь: %.2lf\n", root1);
}
else {
// Два комплексних корені
realPart = -b / (2 * a);
imagPart = sqrt(-discriminant) / (2 * a);
printf("Рівняння має два комплексні корені: %.2lf + %.2lfi і %.2lf - %.2lfi\n",
realPart,
imagPart, realPart, imagPart);
}
return 0;
}